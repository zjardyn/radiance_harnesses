{
  "theme": {
    "mode": "system"
  },
  "buffer_font_size": 15,
  "ui_font_size": 16,
  "terminal": {
    "font_size": 13
  },
  "base_keymap": "Cursor",
  "vim_mode": true,
  "agent": {
    "thinking_display": "always_collapsed"
  },
  "agent_servers": {
    "opencode": {
      "type": "custom",
      "command": "python3",
      "args": [
        "/Users/zjardynhood/.config/zed/acp-thought-filter.py",
        "--",
        "/opt/homebrew/bin/opencode",
        "acp"
      ],
      "env": {
        "OPENCODE_DISABLE_FREE_MODELS": "1",
        "RADIANCE_BASE_URL": "http://10.0.0.168:8000/v1"
      },
      "default_config_options": {
        "effort": "xhigh",
        "model": "radiance/swift15-flash-next:xhigh"
      },
      "favorite_config_option_values": {
        "model": [
          "radiance/swift15-flash-next",
          "radiance/gemma4-26b"
        ]
      }
    }
  },
  "auto_install_extensions": {
    "latex": true
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "pdflatex",
            "args": [
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "%f"
            ],
            "onSave": true,
            "forwardSearchAfter": true
          },
          "forwardSearch": {
            "executable": "displayline",
            "args": [
              "-g",
              "%l",
              "%p",
              "%f"
            ]
          },
          "diagnostics": {
            "delay": 300
          }
        }
      }
    }
  }
}

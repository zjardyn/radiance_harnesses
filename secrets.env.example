# Copy to secrets.env, fill in, and source from your shell profile
# (e.g. `source ~/radiance_harnesses/secrets.env` in ~/.zshrc). Never commit.

# Gates /v1/models and completions on the llama-swap host.
export RADIANCE_API_KEY=""

# Endpoint, if this machine reaches llama-swap at a different address.
# opencode.json reads a fixed baseURL; set this only when you switch to a
# config that references it.
export RADIANCE_BASE_URL="http://10.0.0.168:8000/v1"

# Hides OpenCode's hosted free models. Read at server start, env-only.
export OPENCODE_DISABLE_FREE_MODELS=1

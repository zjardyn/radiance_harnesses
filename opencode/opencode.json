{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "models": {
        "beam-free": {
          "disabled": true
        },
        "big-pickle": {
          "disabled": true
        },
        "crouton-alpha-free": {
          "disabled": true
        },
        "deepseek-v4.1-flash-free": {
          "disabled": true
        },
        "flint-40b-free": {
          "disabled": true
        },
        "glm-5.3-flash-free": {
          "disabled": true
        },
        "iceman-free": {
          "disabled": true
        },
        "inkling-2-small-free": {
          "disabled": true
        },
        "mimo-v2.6-flash-free": {
          "disabled": true
        },
        "nemotron-3.5-lightning-free": {
          "disabled": true
        },
        "nemotron-3.5-super-vl-free": {
          "disabled": true
        }
      }
    },
    "radiance": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Radiance",
      "options": {
        "baseURL": "http://10.0.0.168:8000/v1",
        "apiKey": "{env:RADIANCE_API_KEY}"
      },
      "models": {
        "swift15-flash-next": {
          "name": "Swift 1.5 Flash-Next",
          "limit": {
            "context": 409600,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "body": {
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "body": {
                "reasoning_effort": "medium"
              }
            },
            "xhigh": {
              "body": {
                "reasoning_effort": "xhigh"
              }
            }
          }
        }
      }
    }
  },
  "model": "radiance/swift15-flash-next:xhigh",
  "default_agent": "me",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": ["@cortexkit/opencode-magic-context@latest"]
}

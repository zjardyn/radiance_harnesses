{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "radiance": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Radiance",
      "options": {
        "baseURL": "http://10.0.0.168:8000/v1",
        "apiKey": "{env:RADIANCE_API_KEY}"
      },
      "models": {
        "swift15-flash-next": {
          "name": "Swift 1.5 Flash-Next",
          "capabilities": {
            "reasoning": true
          },
          "limit": {
            "context": 229376,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "body": {
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "body": {
                "reasoning_effort": "medium"
              }
            },
            "xhigh": {
              "body": {
                "reasoning_effort": "xhigh"
              }
            }
          }
        },
        "gemma4-26b": {
          "name": "Gemma 4 26B",
          "capabilities": {
            "reasoning": true
          },
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen35": {
          "name": "Qwen 3.5",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "model": "radiance/swift15-flash-next:xhigh",
  "default_agent": "radiance",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "ls*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "find*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pwd*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "ls*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "find*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "pwd*",
      "effect": "deny"
    }
  ]
}
